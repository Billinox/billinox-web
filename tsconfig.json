{
  "compileOnSave": false,
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@spartan-ng/helm/accordion": [
        "./src/app/components/uis/accordion/src/index.ts"
      ],
      "@spartan-ng/helm/utils": [
        "./src/app/components/uis/utils/src/index.ts"
      ],
      "@spartan-ng/helm/icon": [
        "./src/app/components/uis/icon/src/index.ts"
      ],
      "@spartan-ng/helm/collapsible": [
        "./src/app/components/uis/collapsible/src/index.ts"
      ],
      "@spartan-ng/helm/button": [
        "./src/app/components/uis/button/src/index.ts"
      ],
      "@spartan-ng/helm/input": [
        "./src/app/components/uis/input/src/index.ts"
      ],
      "@spartan-ng/helm/textarea": [
        "./src/app/components/uis/textarea/src/index.ts"
      ],
      "@spartan-ng/helm/select": [
        "./src/app/components/uis/select/src/index.ts"
      ],
      "@spartan-ng/helm/sonner": [
        "./src/app/components/uis/sonner/src/index.ts"
      ],
      "@spartan-ng/helm/spinner": [
        "./src/app/components/uis/spinner/src/index.ts"
      ],
      "@billinox/*": [
        "./*",
        "./src/*"
      ],
      "@spartan-ng/helm/dialog": [
        "./src/app/components/uis/dialog/src/index.ts"
      ],
      "@spartan-ng/helm/date-picker": [
        "./src/app/components/uis/date-picker/src/index.ts"
      ],
      "@spartan-ng/helm/calendar": [
        "./src/app/components/uis/calendar/src/index.ts"
      ],
      "@spartan-ng/helm/popover": [
        "./src/app/components/uis/popover/src/index.ts"
      ],
      "@spartan-ng/helm/field": [
        "./src/app/components/uis/field/src/index.ts"
      ],
      "@spartan-ng/helm/label": [
        "./src/app/components/uis/label/src/index.ts"
      ],
      "@spartan-ng/helm/separator": [
        "./src/app/components/uis/separator/src/index.ts"
      ]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "typeCheckHostBindings": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
